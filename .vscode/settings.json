{
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,
  "cmake.defaultConfigurePreset": "vs2022-x64",
  "cmake.defaultBuildPreset": "vs2022-debug",
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.intelliSenseEngine": "default",
  "files.associations": {
    "*.ino": "cpp",
    "*.h": "cpp",
    "*.hpp": "cpp"
  }
}
